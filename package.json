{
  "name": "@plasius/asset-processing",
  "version": "0.2.0",
  "description": "Processing contracts for Plasius model assets and fail-closed WebGPU WGSL shader admission.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTORS.md",
    "docs",
    "legal"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./shader-admission": {
      "types": "./dist/shader-admission.d.ts",
      "node": {
        "import": "./dist/shader-admission.js",
        "require": "./dist/shader-admission.cjs"
      },
      "default": null
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:eslint": "eslint . --max-warnings=0",
    "audit:deps": "npm ls --all --omit=optional --omit=peer > /dev/null 2>&1 || true",
    "audit:npm": "npm audit --audit-level=high --omit=dev",
    "audit:test": "vitest run --coverage",
    "audit:all": "npm run typecheck && npm run audit:eslint && npm run audit:deps && npm run audit:npm && npm run audit:test",
    "lint": "eslint . --max-warnings=0",
    "pack:check": "node scripts/verify-public-package.cjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run pack:check"
  },
  "keywords": [
    "assets",
    "processing",
    "lod",
    "gltf",
    "cleanup",
    "webgpu",
    "wgsl",
    "shader",
    "plasius"
  ],
  "author": "Plasius LTD <development@plasius.co.uk>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Plasius-LTD/asset-processing.git"
  },
  "bugs": {
    "url": "https://github.com/Plasius-LTD/asset-processing/issues"
  },
  "homepage": "https://github.com/Plasius-LTD/asset-processing#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "funding": [
    {
      "type": "patreon",
      "url": "https://www.patreon.com/c/plasiusltd/membership"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/Plasius-LTD"
    }
  ],
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "nanoid": "3.3.18",
    "esbuild": "$esbuild",
    "minimatch": "^10.2.1"
  },
  "dependencies": {
    "@plasius/asset-contracts": "^0.4.2",
    "@plasius/gpu-shader": "^0.1.7"
  }
}
